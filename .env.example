# ========================================================
# MEETING ROOM BOOKING SYSTEM (MRBS) - CONFIGURATION TEMPLATE
# ========================================================
# Copy this file to .env or configure in Render Environment settings.
# NEVER commit real passwords or API keys to GitHub!

# --- Database Configuration (MySQL / Aiven Cloud) ---
DB_HOST=mysql-xxxxxxxx-your-project.aivencloud.com
DB_PORT=26548
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=your_database_password_here
DB_SSL=true

# Or full database connection URL:
# DATABASE_URL=mysql://avnadmin:your_password@mysql-xxxxxxxx-your-project.aivencloud.com:26548/defaultdb?ssl-mode=REQUIRED

# --- AI Chatbot Assistant Configuration ---
# AI_PROVIDER can be 'gemini' (default, Google Gemini) or 'openai' (OpenAI ChatGPT)
AI_PROVIDER=gemini

# Recommended default models:
# For Gemini: gemini-1.5-flash or gemini-2.0-flash
# For OpenAI: gpt-4o-mini
AI_MODEL=gemini-1.5-flash

# Paste your API key here (Get free Gemini key at: https://aistudio.google.com/app/apikey)
AI_API_KEY=your_gemini_or_openai_api_key_here
